# ==============================================================================
# IssuePilot Environment Configuration Template
# Copy this file to .env and configure real values. Never commit .env to source control.
# ==============================================================================

# Server & Network Configuration
PORT=4000
NODE_ENV=development
BACKEND_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173

# Database (MySQL via Prisma)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:@localhost:3306/issuepilot"

# Session & Security
# Generate with: openssl rand -base64 32
SESSION_SECRET=replace_with_a_secure_random_string_at_least_32_chars

# GitHub App Integration
# Obtained from GitHub App Settings: https://github.com/settings/apps/<your-app-slug>
GITHUB_APP_ID=123456
GITHUB_CLIENT_ID=Iv1.example_client_id
GITHUB_CLIENT_SECRET=replace_with_github_client_secret
GITHUB_WEBHOOK_SECRET=replace_with_github_webhook_secret

# GitHub Private Key
# Store either the raw multiline RSA private key (with \n escaped or multiline string)
# OR specify path to private key file, or base64 encoded private key
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# Open-Weight AI Configuration
# AI_PROVIDER: "hosted" | "local" | "groq" | "ollama" | "openrouter"
AI_PROVIDER=groq
AI_MODEL=gemma2-9b-it
AI_API_KEY=your_inference_api_key_here
AI_BASE_URL=https://api.groq.com/openai/v1

# Semantic Embedding Configuration
# Used for cosine similarity duplicate issue detection
# Recommended: Xenova/all-MiniLM-L6-v2 (local in-process) or embedding API
EMBEDDING_MODEL=all-MiniLM-L6-v2
